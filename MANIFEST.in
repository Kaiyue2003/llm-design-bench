include README.md
include LICENSE
include requirements.txt
include Dockerfile
include compose.yaml
include uv.lock
include .python-version
recursive-include configs *.json
recursive-include docker *.sh
recursive-include src/llm_design_bench py.typed
recursive-include examples *.py
recursive-include docs *.md
recursive-include docs *.json *.txt
recursive-include reference_results *.csv *.json *.md *.png
recursive-include reference_results/additional_methods_integration *.zip *.tex
recursive-include scripts *.py
recursive-include scripts *.sh *.ps1
recursive-include tests *.py
prune results
global-exclude __pycache__/*
global-exclude *.py[cod]
